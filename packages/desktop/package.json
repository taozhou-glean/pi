{
	"name": "@earendil-works/pi-desktop",
	"productName": "Pi Desktop",
	"version": "0.0.0",
	"private": true,
	"description": "Native desktop shell for the Pi coding agent",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "node scripts/build.mjs",
		"dev": "node scripts/build.mjs --watch",
		"smoke": "npm run build && PI_DESKTOP_SMOKE=1 electron .",
		"start": "npm run build && electron .",
		"test": "vitest --run src/*.spec.ts"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.79.5",
		"@xterm/addon-fit": "0.10.0",
		"@xterm/xterm": "5.5.0",
		"node-pty": "1.0.0"
	},
	"devDependencies": {
		"electron": "39.8.10",
		"vitest": "3.2.4"
	}
}
